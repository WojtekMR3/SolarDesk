<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SolarDesk</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SolarDesk.ico</ApplicationIcon>
    <Version>2.9.0</Version>
    <Copyright>Copyright (c) 2026 WojtekMR3</Copyright>
    <Description>Monitor brightness and contrast that follow the sun.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SolarDesk.Core/SolarDesk.Core.csproj" />
  </ItemGroup>
</Project>
