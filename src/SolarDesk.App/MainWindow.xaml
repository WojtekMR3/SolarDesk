<Window x:Class="SolarDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SolarDesk" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{x:Static local:App.DisplayName}" Width="1000" Height="760" MinWidth="820" MinHeight="650" Background="{DynamicResource WindowBase}" Foreground="{DynamicResource Text}" WindowStyle="None" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibilityConverter"/>
    <DataTemplate x:Key="AdditionalSettingsTemplate">
      <StackPanel Margin="0,12,0,0">
        <TextBlock Text="{Binding AdditionalHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding AdvancedControls}"><ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,0,0,8" MinHeight="32" ToolTip="{Binding Hint}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"/>
            <Grid Grid.Column="1" Visibility="{Binding SliderVisibility}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
              <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Title}"/>
              <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ComboBox Grid.Column="1" Style="{StaticResource SettingsChoice}" Tag="{Binding ValueText}" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Choice, Mode=TwoWay}" Visibility="{Binding ChoiceVisibility}" AutomationProperties.Name="{Binding Title}"/>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding UnavailableAdvancedText}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap"/>
        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,3,0,12"/>
        <TextBlock Text="My presets" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox Style="{StaticResource SettingsChoice}" Tag="Choose a preset" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="PresetSelectionChanged" AutomationProperties.Name="Saved monitor presets"/>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Content="Apply" Click="ApplyPresetClick" Padding="8,6" MinHeight="30" FontSize="11"/>
          <Button Grid.Column="2" Content="Delete" Click="DeletePresetClick" Padding="8,6" MinHeight="30" FontSize="11" Style="{StaticResource QuietButton}"/>
        </Grid>
        <TextBlock Text="Name" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,12,0,4"/>
        <TextBox Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Preset name"/>
        <TextBlock Text="Shortcut" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,8,0,4"/>
        <ComboBox Style="{StaticResource SettingsChoice}" ItemsSource="{x:Static local:MonitorViewModel.HotkeyLabels}" SelectedIndex="{Binding PresetHotkey, Mode=TwoWay}" AutomationProperties.Name="Preset shortcut"/>
        <Button Content="Save current as preset" Click="SavePresetClick" Margin="0,8,0,0" Padding="8,6" MinHeight="30" FontSize="11"/>
        <TextBlock Text="Saves this display's selected profile. Apply restores it to the current Day or Night profile." FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
      </StackPanel>
    </DataTemplate>
    <RadialGradientBrush x:Key="StarHalo"><GradientStop Color="#F0E9F0FF" Offset="0"/><GradientStop Color="#90CFDFFF" Offset="0.18"/><GradientStop Color="#306E94D8" Offset="0.42"/><GradientStop Color="#006E94D8" Offset="1"/></RadialGradientBrush>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Grid ClipToBounds="True" Background="{DynamicResource WindowBase}">
    <Grid x:Name="DayAtmosphere" IsHitTestVisible="False">
      <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EED9AE" Offset="0"/><GradientStop Color="#F1E2CC" Offset="0.35"/><GradientStop Color="#E8D4BA" Offset="0.65"/><GradientStop Color="#DEBAA1" Offset="1"/></LinearGradientBrush></Grid.Background>
      <Border x:Name="DayGlowSurface"><Border.Background><RadialGradientBrush Center="0.12,0.08" GradientOrigin="0.12,0.08" RadiusX="0.8" RadiusY="0.65"><GradientStop Color="#60FFE4A1" Offset="0"/><GradientStop Color="#20FFE4A1" Offset="0.5"/><GradientStop Color="#00FFE4A1" Offset="1"/></RadialGradientBrush></Border.Background></Border>
      <Border><Border.Background><RadialGradientBrush Center="0.95,0.16" GradientOrigin="0.95,0.16" RadiusX="0.7" RadiusY="0.65"><GradientStop Color="#90DDB6C2" Offset="0"/><GradientStop Color="#30DDB6C2" Offset="0.5"/><GradientStop Color="#00DDB6C2" Offset="1"/></RadialGradientBrush></Border.Background></Border>
      <Border><Border.Background><RadialGradientBrush Center="0.02,0.95" GradientOrigin="0.02,0.95" RadiusX="0.7" RadiusY="0.65"><GradientStop Color="#80D6AFBE" Offset="0"/><GradientStop Color="#00D6AFBE" Offset="1"/></RadialGradientBrush></Border.Background></Border>
      <Canvas x:Name="DayRaysSurface" Width="240" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,130,36,0" IsHitTestVisible="False">
        <Ellipse x:Name="BackgroundSunGlow" Width="150" Height="150" Canvas.Left="45" Canvas.Top="-5" Opacity="0.65">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#75F4C56B" Offset="0"/><GradientStop Color="#20F4C56B" Offset="0.5"/><GradientStop Color="#00F4C56B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Canvas x:Name="SunRayStreaks" Width="240" Height="220"/>
        <Ellipse Width="48" Height="48" Canvas.Left="96" Canvas.Top="46" Opacity="0.52">
          <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F6D38C" Offset="0"/><GradientStop Color="#DFA255" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
        </Ellipse>
      </Canvas>
    </Grid>
    <Grid x:Name="NightAtmosphere" IsHitTestVisible="False" Opacity="0">
      <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1"><GradientStop Color="#111A31" Offset="0"/><GradientStop Color="#0C1324" Offset="0.4"/><GradientStop Color="#090E1A" Offset="1"/></LinearGradientBrush></Grid.Background>
      <Border x:Name="NightGlowSurface"><Border.Background><RadialGradientBrush Center="0.68,0.19" GradientOrigin="0.68,0.19" RadiusX="0.55" RadiusY="0.5"><GradientStop Color="#383C478E" Offset="0"/><GradientStop Color="#003C478E" Offset="1"/></RadialGradientBrush></Border.Background></Border>
      <Viewbox Stretch="Fill"><Canvas x:Name="StarField" Width="1000" Height="800">
        <Ellipse Width="2" Height="2" Fill="#ADBDD9" Canvas.Left="292" Canvas.Top="31" Opacity="0.6"/>
        <Ellipse Width="3" Height="3" Fill="#CFD9F2" Canvas.Left="346" Canvas.Top="88" Opacity="0.65"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="404" Canvas.Top="47" Opacity="0.45"/>
        <Ellipse Width="2" Height="2" Fill="#D7DFF3" Canvas.Left="467" Canvas.Top="118" Opacity="0.6"/>
        <Ellipse Width="3" Height="3" Fill="#D5DEF5" Canvas.Left="552" Canvas.Top="64" Opacity="0.55"/>
        <Ellipse Width="2" Height="2" Fill="#CFD9F2" Canvas.Left="618" Canvas.Top="109" Opacity="0.4"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="708" Canvas.Top="38" Opacity="0.65"/>
        <Ellipse Width="2" Height="2" Fill="#CFD9F2" Canvas.Left="774" Canvas.Top="116" Opacity="0.55"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="846" Canvas.Top="33" Opacity="0.45"/>
        <Ellipse Width="2" Height="2" Fill="#CFD9F2" Canvas.Left="974" Canvas.Top="129" Opacity="0.5"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="20" Canvas.Top="188" Opacity="0.4"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="984" Canvas.Top="398" Opacity="0.4"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="166" Canvas.Top="744" Opacity="0.3"/>
        <Ellipse Width="2" Height="2" Fill="#CFD9F2" Canvas.Left="383" Canvas.Top="725" Opacity="0.4"/>
        <Ellipse Width="2" Height="2" Fill="#CFD9F2" Canvas.Left="663" Canvas.Top="751" Opacity="0.35"/>
        <Ellipse Width="2" Height="2" Fill="#A7B9DA" Canvas.Left="952" Canvas.Top="735" Opacity="0.4"/>
        <Ellipse Width="9" Height="9" Fill="{StaticResource StarHalo}" Canvas.Left="484" Canvas.Top="35" Opacity="0.75"/>
        <Ellipse Width="7" Height="7" Fill="{StaticResource StarHalo}" Canvas.Left="733" Canvas.Top="78" Opacity="0.65"/>
        <Ellipse Width="8" Height="8" Fill="{StaticResource StarHalo}" Canvas.Left="434" Canvas.Top="164" Opacity="0.7"/>
        <Ellipse Width="7" Height="7" Fill="{StaticResource StarHalo}" Canvas.Left="820" Canvas.Top="727" Opacity="0.6"/>
        <Ellipse Width="1.4" Height="1.4" Fill="#C1D1EB" Canvas.Left="321" Canvas.Top="143" Opacity="0.45"/>
        <Ellipse Width="1.5" Height="1.5" Fill="#D2DDF2" Canvas.Left="589" Canvas.Top="33" Opacity="0.55"/>
        <Ellipse Width="1.3" Height="1.3" Fill="#C1D1EB" Canvas.Left="683" Canvas.Top="146" Opacity="0.35"/>
        <Ellipse Width="1.6" Height="1.6" Fill="#D2DDF2" Canvas.Left="532" Canvas.Top="737" Opacity="0.45"/>
      </Canvas></Viewbox>
    </Grid>
    <Grid x:Name="MainSurface">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Grid Margin="24,0,12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="15" Height="15" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="6" Stroke="{DynamicResource Accent}" StrokeThickness="2"/><Path Data="M12,0 L12,3 M12,21 L12,24 M0,12 L3,12 M21,12 L24,12 M3,3 L5,5 M19,19 L21,21 M3,21 L5,19 M19,5 L21,3" Stroke="{DynamicResource Accent}" StrokeThickness="2"/></Canvas></Viewbox>
          <TextBlock Text="{x:Static local:App.DisplayName}" Foreground="{DynamicResource ValueText}" FontWeight="SemiBold" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="−" Style="{StaticResource QuietButton}" Padding="14,0" MinHeight="30" Click="MinimizeClick" AutomationProperties.Name="Minimize"/>
          <Button Content="×" Style="{StaticResource QuietButton}" Padding="14,0" MinHeight="30" FontSize="19" Click="HideClick" AutomationProperties.Name="Close to tray"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,15,28,18">
          <Grid x:Name="ContextHeader" Margin="0,0,12,24" MinHeight="62">
            <Grid.ColumnDefinitions><ColumnDefinition Width="63"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
            <Viewbox Grid.ColumnSpan="6" Stretch="Fill" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.4"><Canvas x:Name="WeatherParticles" Width="1000" Height="70" ClipToBounds="True"/></Viewbox>
              <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource BadgeSurface}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid ClipToBounds="True">
                  <Grid.Clip><RectangleGeometry Rect="0,0,48,48" RadiusX="16" RadiusY="16"/></Grid.Clip>
                  <Viewbox x:Name="SunEmblem" Width="29" Height="29"><Viewbox.RenderTransform><TranslateTransform x:Name="SunRise"/></Viewbox.RenderTransform><Canvas Width="32" Height="32"><Ellipse Width="14" Height="14" Canvas.Left="9" Canvas.Top="9" Fill="{DynamicResource SunColor}"/><Path Data="M16,1 L16,5 M16,27 L16,31 M1,16 L5,16 M27,16 L31,16 M5,5 L8,8 M24,24 L27,27 M5,27 L8,24 M24,8 L27,5" Stroke="{DynamicResource SunColor}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                  <Viewbox x:Name="MoonEmblem" Width="30" Height="30" Opacity="0"><Viewbox.RenderTransform><TranslateTransform x:Name="MoonRise" Y="38"/></Viewbox.RenderTransform><Canvas Width="28" Height="28"><Path Data="M22,16 A10,10 0 0 1 12,4 A10,10 0 1 0 22,16 Z" Fill="#DADEFF"/><Ellipse Width="2.5" Height="2.5" Canvas.Left="22" Canvas.Top="5" Fill="#D9E3FF"/><Ellipse Width="1.5" Height="1.5" Canvas.Left="18" Canvas.Top="1" Fill="#AEBFFF"/></Canvas></Viewbox>
                </Grid>
              </Border>
            <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Button x:Name="LocationChip" Click="LocationClick" Style="{StaticResource QuietButton}" Padding="0,3" HorizontalContentAlignment="Stretch" ToolTip="Change location">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock x:Name="LocationText" Text="Set location" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
              </Button>
              <TextBlock Grid.Row="1" x:Name="DisplayCountText" Text="Finding your monitors…" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </Grid>
            <Border x:Name="WeatherPanel" Grid.Column="2" Padding="10,0" BorderBrush="{DynamicResource TabBorder}" BorderThickness="1,0,0,0" VerticalAlignment="Center" ToolTip="Weather by Open-Meteo">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox Width="29" Height="29" VerticalAlignment="Center"><Path x:Name="WeatherIcon" Stroke="{DynamicResource AccentText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,12 L21,12"/></Viewbox>
                <StackPanel Grid.Column="1"><TextBlock x:Name="TemperatureText" Text="— °C" FontSize="22"/><TextBlock x:Name="WeatherText" Text="Loading weather" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
              </Grid>
            </Border>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Local sunrise, before schedule offsets">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Margin="0,0,5,0" IsHitTestVisible="False"><Canvas Width="24" Height="24">
                  <Path Data="M5,15 A7,7 0 0 1 19,15 Z" Fill="{DynamicResource SunColor}"/>
                  <Path Data="M12,2 L12,5 M3,7 L5,9 M21,7 L19,9 M1,13 L3,13 M21,13 L23,13" Stroke="{DynamicResource SunColor}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Path Data="M2,17 L22,17 M6,21 L18,21" Stroke="{DynamicResource SunriseColor}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas></Viewbox>
                <TextBlock Text="SUNRISE" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="SunriseText" Text="—" FontSize="21" Margin="0,5,0,0" Foreground="{DynamicResource SunriseColor}"/>
            </StackPanel>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Local sunset, before schedule offsets">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Margin="0,0,5,0" IsHitTestVisible="False"><Canvas Width="24" Height="24">
                  <Path Data="M22,16 A10,10 0 0 1 12,4 A10,10 0 1 0 22,16 Z" Fill="{DynamicResource SunsetColor}"/>
                  <Path Data="M20,3 L20,7 M18,5 L22,5" Stroke="{DynamicResource SunsetColor}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas></Viewbox>
                <TextBlock Text="SUNSET" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="SunsetText" Text="—" FontSize="21" Margin="0,5,0,0" Foreground="{DynamicResource SunsetColor}"/>
            </StackPanel>
              <Button Grid.Column="5" Click="SettingsClick" Style="{StaticResource QuietButton}" Padding="10" VerticalAlignment="Center" ToolTip="Settings" AutomationProperties.Name="Settings">
                <Viewbox Width="18" Height="18"><Canvas Width="26" Height="26"><Path Data="M10,3 L15,3 L16,6 L18,7 L21,6 L23,10 L20,12 L20,14 L23,16 L21,20 L18,19 L16,20 L15,23 L10,23 L9,20 L7,19 L4,20 L2,16 L5,14 L5,12 L2,10 L4,6 L7,7 L9,6 Z" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round"/><Ellipse Width="7" Height="7" Canvas.Left="9" Canvas.Top="9.5" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/></Canvas></Viewbox>
              </Button>
          </Grid>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource TabRail}" BorderBrush="{DynamicResource TabBorder}" BorderThickness="1" CornerRadius="14" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DayTab" GroupName="Profile" Style="{StaticResource ProfileTab}" IsChecked="True" Checked="ProfileSelected" Tag="Day" Margin="0,0,4,0" ToolTip="Apply and edit Day settings. Auto off keeps Day active; Auto on resumes at the next sun transition." AutomationProperties.Name="Apply day profile">
                  <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/><Path Data="M12,0 L12,3 M12,21 L12,24 M0,12 L3,12 M21,12 L24,12 M3,3 L5,5 M19,19 L21,21 M3,21 L5,19 M19,5 L21,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/></Canvas></Viewbox><TextBlock Text="Day"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NightTab" GroupName="Profile" Style="{StaticResource ProfileTab}" Checked="ProfileSelected" Tag="Night" ToolTip="Apply and edit Night settings. Auto off keeps Night active; Auto on resumes at the next sun transition." AutomationProperties.Name="Apply night profile">
                  <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,8,0"><Path Data="M22,16 A10,10 0 0 1 12,4 A10,10 0 1 0 22,16 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5"/></Viewbox><TextBlock Text="Night"/></StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="LinkModeBox" Style="{StaticResource LinkModeSelector}" Width="158" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" SelectionChanged="LinkModeChanged" AutomationProperties.Name="Display sync mode">
              <ComboBoxItem Content="Individual" Tag="Your saved per-display values" ToolTip="Restore and edit your saved Individual values."/>
              <ComboBoxItem Content="Mass mode" Tag="Your saved shared values" ToolTip="Use three shared sliders to set values across all supported displays."/>
              <ComboBoxItem Content="Offset mode" Tag="Your saved baseline and offsets" ToolTip="Use offsets around 0 to adjust your saved profile values together."/>
            </ComboBox>
            <Border x:Name="LinkedModeBadge" Background="{DynamicResource BadgeSurface}" CornerRadius="8" Padding="9,5" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,5,0"><Path Data="M9,14 L14,9 M7,16 L5,18 A4,4 0 0 1 0,13 L5,8 A4,4 0 0 1 10,8 M12,5 L14,3 A4,4 0 0 1 19,8 L14,13 A4,4 0 0 1 9,13" Stroke="{DynamicResource AccentText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Text="Linked" Foreground="{DynamicResource AccentText}" FontSize="11"/></StackPanel>
            </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="Auto" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <ToggleButton x:Name="AutomationButton" Style="{StaticResource Switch}" Click="AutomationClick" ToolTip="Switch between day and night settings with the sun" AutomationProperties.Name="Automatic sunrise and sunset schedule"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="EmptyText" Text="Finding your monitors…" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
          <ScrollViewer x:Name="MonitorScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="MonitorViewportChanged">
            <ItemsControl x:Name="MonitorItems">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="MonitorCard" Width="{Binding CardWidth}" VerticalAlignment="Top">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}">
                      <Setter Property="Margin" Value="0,12,12,12"/><Setter Property="Padding" Value="20"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimarySurface}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/><Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Padding" Value="24,26"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSharedView}" Value="True"><Setter Property="Padding" Value="14"/></DataTrigger>
                      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSharedView}" Value="True"/><Condition Binding="{Binding IsPrimary}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Padding" Value="18"/></MultiDataTrigger>
                      </Style.Triggers>
                    </Style></Border.Style>
                    <StackPanel>
                      <Grid x:Name="MonitorPosition" Height="22" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PositionLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Accent}" CornerRadius="7" Padding="8,5" HorizontalAlignment="Right" Visibility="{Binding IsPrimary, Converter={StaticResource BoolVisibilityConverter}}"><TextBlock Text="MAIN DISPLAY" Foreground="{DynamicResource OnAccent}" FontSize="9" FontWeight="Bold"/></Border>
                      </Grid>
                      <Grid x:Name="MonitorIconRow" Height="52" Margin="0,0,0,10" ToolTip="{Binding DisplayDetails}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                          <Border x:Name="MonitorScreen" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource PrimaryBorder}" Background="{DynamicResource BadgeSurface}">
                            <TextBlock Text="{Binding DisplayNumber}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <Border Width="2" Height="6" Background="{DynamicResource PrimaryBorder}"/>
                          <Border Width="26" Height="2" CornerRadius="1" Background="{DynamicResource PrimaryBorder}"/>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding ShortName}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                      <TextBlock x:Name="MonitorResolution" Text="{Binding DisplayDetails}" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Center" Margin="0,5,0,14"/>
                      <UniformGrid Columns="3" Visibility="{Binding IsSharedView, Converter={StaticResource BoolVisibilityConverter}}" Margin="0,0,0,0">
                        <StackPanel><TextBlock Text="Brightness" FontSize="10" Foreground="{DynamicResource Muted}" TextAlignment="Center"/><TextBlock Text="{Binding SelectedBrightnessText}" FontSize="21" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Contrast" FontSize="10" Foreground="{DynamicResource Muted}" TextAlignment="Center"/><TextBlock Text="{Binding SelectedContrastText}" FontSize="21" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Saturation" FontSize="10" Foreground="{DynamicResource Muted}" TextAlignment="Center"/><TextBlock Text="{Binding SelectedSaturationText}" FontSize="21" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                      </UniformGrid>
                      <StackPanel Visibility="{Binding IsIndividualView, Converter={StaticResource BoolVisibilityConverter}}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Brightness" FontSize="11" TextAlignment="Center"/>
                          <TextBlock Text="{Binding SelectedBrightnessText}" FontSize="26" FontWeight="Light" TextAlignment="Center" Margin="0,5,0,10"/>
                          <Slider Value="{Binding SelectedBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" Style="{StaticResource VerticalControl}" Width="56" Foreground="{DynamicResource BrightnessFill}" Background="{DynamicResource BrightnessThumb}" IsEnabled="{Binding HasBrightness}" AutomationProperties.Name="Brightness" ToolTip="Drag up for brighter. Changes apply immediately."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Contrast" FontSize="11" TextAlignment="Center"/>
                          <TextBlock Text="{Binding SelectedContrastText}" FontSize="26" FontWeight="Light" TextAlignment="Center" Margin="0,5,0,10"/>
                          <Slider Value="{Binding SelectedContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VerticalControl}" Width="56" Foreground="{DynamicResource ContrastFill}" Background="{DynamicResource ContrastThumb}" IsEnabled="{Binding HasContrast}" AutomationProperties.Name="Contrast" ToolTip="Drag up for more contrast."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Saturation" FontSize="11" TextAlignment="Center"/>
                          <TextBlock Text="{Binding SelectedSaturationText}" FontSize="26" FontWeight="Light" TextAlignment="Center" Margin="0,5,0,10"/>
                          <Slider Value="{Binding SelectedSaturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VerticalControl}" Width="56" local:SaturationAppearance.Level="{Binding SelectedSaturation}" local:SaturationAppearance.Color="{DynamicResource SaturationColor}" BorderBrush="White" IsEnabled="{Binding HasSaturation}" AutomationProperties.Name="Saturation" ToolTip="{Binding SaturationHint}"/>
                        </StackPanel>
                      </Grid>
                      </StackPanel>
                      <Expander Header="Additional settings" Margin="0,18,0,0" Foreground="{DynamicResource Muted}" AutomationProperties.Name="Additional monitor settings">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AdditionalSettingsTemplate}" Foreground="{DynamicResource Text}"/>
                      </Expander>
                      <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorColor}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVisibilityConverter}}"/>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSharedView}" Value="True">
                    <Setter TargetName="MonitorPosition" Property="Margin" Value="0,0,0,4"/>
                    <Setter TargetName="MonitorIconRow" Property="Margin" Value="0,0,0,6"/>
                    <Setter TargetName="MonitorResolution" Property="Margin" Value="0,4,0,8"/>
                  </DataTrigger></DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border x:Name="SharedControlsPanel" Style="{StaticResource Card}" Width="430" HorizontalAlignment="Center" Padding="24,20" Margin="0,0,12,0" Visibility="Collapsed">
            <StackPanel>
              <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                  <Border x:Name="SharedMonitorScreen" Width="76" Height="43" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource PrimaryBorder}" Background="{DynamicResource BadgeSurface}">
                    <Viewbox Width="23" Height="18"><Path Data="M9,14 L14,9 M7,16 L5,18 A4,4 0 0 1 0,13 L5,8 A4,4 0 0 1 10,8 M12,5 L14,3 A4,4 0 0 1 19,8 L14,13 A4,4 0 0 1 9,13" Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                  </Border>
                  <Border Width="2" Height="6" Background="{DynamicResource PrimaryBorder}"/>
                  <Border Width="26" Height="2" CornerRadius="1" Background="{DynamicResource PrimaryBorder}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="SharedControlsTitle" Text="All displays" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SharedDisplayList" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Brightness" FontSize="12" TextAlignment="Center"/>
                  <TextBlock x:Name="SharedBrightnessValue" TextAlignment="Center" Foreground="{DynamicResource ValueText}" FontSize="25" FontWeight="Light" Margin="0,5,0,10"/>
                  <Grid Height="132">
                    <Slider x:Name="SharedBrightnessSlider" Tag="Brightness" Style="{StaticResource VerticalControl}" Foreground="{DynamicResource BrightnessFill}" Background="{DynamicResource BrightnessThumb}" ValueChanged="SharedSliderChanged" AutomationProperties.Name="Shared brightness"/>
                    <Grid x:Name="SharedBrightnessRange" Width="24" HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="Collapsed">
                      <TextBlock Text="+100" FontSize="8" Foreground="{DynamicResource Muted}" VerticalAlignment="Top"/>
                      <TextBlock Text="0" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                      <TextBlock Text="&#x2212;100" FontSize="8" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom"/>
                    </Grid>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Contrast" FontSize="12" TextAlignment="Center"/>
                  <TextBlock x:Name="SharedContrastValue" TextAlignment="Center" Foreground="{DynamicResource ValueText}" FontSize="25" FontWeight="Light" Margin="0,5,0,10"/>
                  <Grid Height="132">
                    <Slider x:Name="SharedContrastSlider" Tag="Contrast" Style="{StaticResource VerticalControl}" Foreground="{DynamicResource ContrastFill}" Background="{DynamicResource ContrastThumb}" ValueChanged="SharedSliderChanged" AutomationProperties.Name="Shared contrast"/>
                    <Grid x:Name="SharedContrastRange" Width="24" HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="Collapsed">
                      <TextBlock Text="+100" FontSize="8" Foreground="{DynamicResource Muted}" VerticalAlignment="Top"/>
                      <TextBlock Text="0" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                      <TextBlock Text="&#x2212;100" FontSize="8" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom"/>
                    </Grid>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Saturation" FontSize="12" TextAlignment="Center"/>
                  <TextBlock x:Name="SharedSaturationValue" TextAlignment="Center" Foreground="{DynamicResource ValueText}" FontSize="25" FontWeight="Light" Margin="0,5,0,10"/>
                  <Grid Height="132">
                    <Slider x:Name="SharedSaturationSlider" Tag="Saturation" Style="{StaticResource VerticalControl}" local:SaturationAppearance.Color="{DynamicResource SaturationColor}" BorderBrush="White" ValueChanged="SharedSliderChanged" AutomationProperties.Name="Shared saturation"/>
                    <Grid x:Name="SharedSaturationRange" Width="24" HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="Collapsed">
                      <TextBlock Text="+100" FontSize="8" Foreground="{DynamicResource Muted}" VerticalAlignment="Top"/>
                      <TextBlock Text="0" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                      <TextBlock Text="&#x2212;100" FontSize="8" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom"/>
                    </Grid>
                  </Grid>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="SharedControlsHint" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
              <Button x:Name="ResetOffsetsButton" Content="Reset to 0" Click="ResetOffsetsClick" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,7" MinHeight="30" FontSize="11"/>
              <Expander Header="Additional settings" Foreground="{DynamicResource Muted}" Margin="0,18,0,0" AutomationProperties.Name="Additional settings for all displays">
                <ItemsControl x:Name="SharedAdditionalItems" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                  <Expander Header="{Binding ShortName}" Foreground="{DynamicResource Text}" Margin="0,6,0,6">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AdditionalSettingsTemplate}"/>
                  </Expander>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Expander>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SubtleSurface}" CornerRadius="14" Margin="0,12,12,0" Padding="18,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PhaseText" Text="Follow the sun" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="NextEventText" Text="Set a location for automatic day and night settings." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="28,0,28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="MessageText" Text="Changes apply instantly and save automatically." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        <Button x:Name="MatchMainButton" Grid.Column="1" Content="Match main display" Click="MatchMainClick" Style="{StaticResource QuietButton}" Padding="8,0" Margin="0,0,8,0" FontSize="11" Visibility="Collapsed" ToolTip="Apply the main display's values to all supported controls."/>
        <Button x:Name="ResumeButton" Grid.Column="2" Content="Resume auto" Click="ResumeClick" Style="{StaticResource QuietButton}" Padding="8,0" HorizontalAlignment="Right" FontSize="11" Visibility="Collapsed"/>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsLayer" Visibility="Collapsed" Background="#B0000000" KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="SettingsCard" Style="{StaticResource Card}" Width="720" MaxHeight="740" VerticalAlignment="Center" Padding="26">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,22">
            <StackPanel><TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Schedule, appearance and connected displays." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
            <Button x:Name="CloseSettingsButton" Content="&#xD7;" FontSize="20" Click="CloseSettingsClick" Style="{StaticResource QuietButton}" Padding="10,0" VerticalAlignment="Top" HorizontalAlignment="Right" AutomationProperties.Name="Close settings"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Schedule" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                  <TextBlock Text="Ease your displays into day and night." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,20"/>
                  <Grid><TextBlock Text="Fade duration" FontSize="12"/><Border Background="{DynamicResource BadgeSurface}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock x:Name="FadeLabel" Text="30 min" Foreground="{DynamicResource AccentText}" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
                  <Slider x:Name="FadeSlider" Maximum="120" TickFrequency="5" Value="30" ValueChanged="FadeChanged" AutomationProperties.Name="Fade duration in minutes" Margin="0,10,0,3"/>
                  <Grid Margin="0,0,0,14"><TextBlock Text="Instant" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="2 hours" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></Grid>
                  <CheckBox x:Name="SunRemindersCheck" Content="Sunrise and sunset reminders" Click="SunSettingClick" Margin="0,2,0,5"/>
                  <TextBlock Text="Notify me 30 minutes before, with fade timing." Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <Expander Header="Timing &amp; coordinates" Foreground="{DynamicResource Muted}" Margin="0,0,0,20">
              <StackPanel Margin="0,16,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Sunrise offset (min)" Style="{StaticResource Label}"/><TextBox x:Name="RiseOffsetBox" Text="0" LostFocus="OffsetChanged" AutomationProperties.Name="Sunrise offset in minutes"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Sunset offset (min)" Style="{StaticResource Label}"/><TextBox x:Name="SetOffsetBox" Text="0" LostFocus="OffsetChanged" AutomationProperties.Name="Sunset offset in minutes"/></StackPanel>
                </Grid>
                <TextBlock Text="Negative values move the transition earlier." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,16"/>
                <Expander x:Name="ManualLocationExpander" Header="Coordinates" Foreground="{DynamicResource Muted}">
                  <StackPanel Margin="0,12,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Latitude" Style="{StaticResource Label}"/><TextBox x:Name="LatitudeBox" AutomationProperties.Name="Latitude"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Longitude" Style="{StaticResource Label}"/><TextBox x:Name="LongitudeBox" AutomationProperties.Name="Longitude"/></StackPanel></Grid>
                    <TextBlock Text="Time zone" Style="{StaticResource Label}" Margin="0,12,0,6"/><ComboBox x:Name="ZoneBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" AutomationProperties.Name="Time zone"/>
                    <Button Content="Save location" Click="SaveLocationClick" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Appearance &amp; startup" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                  <TextBlock Text="The background follows your Day or Night profile." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <CheckBox x:Name="DayRaysCheck" Content="Soft sun rays in Day mode" Click="SunSettingClick" Margin="0,0,0,13"/>
                  <CheckBox x:Name="WeatherCheck" Content="Show local weather" Click="WeatherSettingClick" Margin="0,0,0,13"/>
                  <CheckBox x:Name="WeatherEffectsCheck" Content="Gentle rain and snow effects" Click="WeatherSettingClick" Margin="0,0,0,13"/>
                  <CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="StartupClick" Margin="0,0,0,8"/>
                  <TextBlock Text="Weather uses approximate location and an internet connection." Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <Button Content="Weather by Open-Meteo &#xB7; CC BY 4.0" Click="WeatherCreditClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,3" MinHeight="24" FontSize="10"/>
                </StackPanel>
              </Border>
              </Grid>
              <Border Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Connected displays" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                  <TextBlock Text="Choose which displays follow the automatic schedule." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <ItemsControl x:Name="AutoMonitorItems"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding ShortName}" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanControl}" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,20"><Button x:Name="RefreshButton" Content="Refresh displays" Click="RefreshClick" Margin="0,0,10,0"/><Button Content="Restore originals" Click="RestoreClick"/></StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{x:Static local:App.VersionLabel}" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="City data: GeoNames &#xB7; CC BY 4.0" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Quit app" Click="QuitClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Done" Click="CloseSettingsClick" Style="{StaticResource PrimaryButton}" MinWidth="80"/></StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="LocationLayer" Visibility="Collapsed" Background="#D0000000" KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="LocationCard" Style="{StaticResource Card}" Width="450" Padding="32" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid Height="72" Margin="0,0,0,22">
            <Ellipse Width="64" Height="64" Fill="{DynamicResource BadgeSurface}" HorizontalAlignment="Left"/>
            <Viewbox Width="34" Height="34" HorizontalAlignment="Left" Margin="15,0,0,0"><Canvas Width="40" Height="40"><Path Data="M4,25 A16,16 0 0 1 36,25" Stroke="{DynamicResource Accent}" StrokeThickness="2"/><Path Data="M0,28 L40,28 M7,34 L33,34" Stroke="{DynamicResource Accent}" StrokeThickness="2"/><Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}" Canvas.Top="13" Canvas.Left="14"/></Canvas></Viewbox>
          </Grid>
          <TextBlock Text="A little brighter by day.&#xA;A little softer at night." FontSize="25" FontWeight="SemiBold" LineHeight="34"/>
          <TextBlock Text="Use your location to find local sunrise and sunset." Foreground="{DynamicResource Muted}" Margin="0,14,0,24" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
          <TextBlock x:Name="LocationHelpText" Text="" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
          <Button x:Name="DetectButton" Content="Use my location" Click="DetectClick" Style="{StaticResource PrimaryButton}" MinHeight="44"/>
          <Button x:Name="LocationPermissionButton" Content="Open Windows location settings" Click="LocationPermissionsClick" Style="{StaticResource QuietButton}" Margin="0,6,0,0" Visibility="Collapsed"/>
          <Expander x:Name="CitySearchExpander" Header="Choose a city instead" Foreground="{DynamicResource Muted}" Margin="0,18,0,0">
            <StackPanel Margin="0,12,0,0"><TextBox x:Name="CitySearchBox" TextChanged="CitySearchChanged" AutomationProperties.Name="Search cities" ToolTip="Type a city name"/><ListBox x:Name="CityResults" MaxHeight="150" Background="{DynamicResource WindowBase}" Foreground="{DynamicResource Text}" BorderThickness="0" Margin="0,6,0,0" PreviewMouseLeftButtonUp="CityClicked" PreviewKeyDown="CityKeyDown" AutomationProperties.Name="Matching cities; choose with Enter"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5,5"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Country}" Foreground="{DynamicResource Muted}" Margin="10,0,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
          </Expander>
          <Button x:Name="SkipLocationButton" Content="Not now" Click="SkipLocationClick" Style="{StaticResource QuietButton}" Margin="0,18,0,0"/>
          <TextBlock Text="Sun times work offline. Weather uses approximate location." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
