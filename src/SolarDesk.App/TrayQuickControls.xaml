<Window x:Class="SolarDesk.TrayQuickControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolarDesk quick controls" Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" PreviewKeyDown="QuickKeyDown">
  <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" Padding="20,16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="SolarDesk" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Quick display controls" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Content="&#xD7;" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource QuietButton}" Padding="10,0" MinHeight="28" FontSize="20" Click="DismissClick" AutomationProperties.Name="Close quick controls"/>
        </Grid>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <RadioButton x:Name="QuickDay" Content="Day" GroupName="QuickProfile" Style="{StaticResource ProfileTab}" Padding="12,7" MinWidth="0" MinHeight="36" Click="DayClick"/>
          <RadioButton x:Name="QuickNight" Grid.Column="1" Content="Night" GroupName="QuickProfile" Style="{StaticResource ProfileTab}" Padding="12,7" MinWidth="0" MinHeight="36" Click="NightClick"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="Auto" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ToggleButton x:Name="QuickAuto" Style="{StaticResource Switch}" Click="AutoClick" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Quick automatic sunrise and sunset schedule"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Control mode" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox x:Name="QuickMode" Style="{StaticResource SettingsChoice}" SelectionChanged="ModeChanged" AutomationProperties.Name="Quick control mode">
          <ComboBoxItem Content="Individual"/>
          <ComboBoxItem Content="Mass"/>
          <ComboBoxItem Content="Offset"/>
        </ComboBox>
        <StackPanel x:Name="MonitorSelector" Margin="0,10,0,0">
          <TextBlock Text="Display" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
          <ComboBox x:Name="QuickMonitor" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource SettingsChoice}" SelectionChanged="MonitorChanged" AutomationProperties.Name="Quick controls display"/>
        </StackPanel>
        <TextBlock x:Name="QuickHint" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,12"/>
        <Grid>
          <TextBlock Text="Brightness"/>
          <TextBlock x:Name="BrightnessValue" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
        <Slider x:Name="BrightnessSlider" Tag="Brightness" ValueChanged="ControlChanged" Foreground="{DynamicResource BrightnessThumb}" Margin="0,2,0,10" AutomationProperties.Name="Quick brightness"/>
        <Grid>
          <TextBlock Text="Contrast"/>
          <TextBlock x:Name="ContrastValue" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
        <Slider x:Name="ContrastSlider" Tag="Contrast" ValueChanged="ControlChanged" Margin="0,2,0,10" AutomationProperties.Name="Quick contrast"/>
        <Grid>
          <TextBlock Text="Saturation"/>
          <TextBlock x:Name="SaturationValue" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
        <Slider x:Name="SaturationSlider" Tag="Saturation" ValueChanged="ControlChanged" Style="{StaticResource ColorSlider}" Margin="0,2,0,8" AutomationProperties.Name="Quick saturation"/>
        <TextBlock x:Name="QuickError" Foreground="{DynamicResource ErrorColor}" FontSize="11" TextWrapping="Wrap"/>
        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,10,0,10"/>
        <TextBlock x:Name="QuickSchedule" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="QuickRefresh" Content="Refresh displays" Click="RefreshClick" Style="{StaticResource QuietButton}" Padding="8,6" FontSize="11"/>
          <Button Grid.Column="2" Content="Open full settings" Click="OpenClick" Padding="8,6"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
