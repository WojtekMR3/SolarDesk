<Window x:Class="SolarDesk.TrayQuickControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SolarDesk"
        Title="SolarDesk quick controls" Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" PreviewKeyDown="QuickKeyDown">
  <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" Padding="20,16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="SolarDesk" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Quick display controls" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Content="&#xD7;" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource QuietButton}" Padding="10,0" MinHeight="28" FontSize="20" Click="DismissClick" AutomationProperties.Name="Close quick controls"/>
        </Grid>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <RadioButton x:Name="QuickDay" Content="Day" GroupName="QuickProfile" Style="{StaticResource ProfileTab}" Padding="12,7" MinWidth="0" MinHeight="36" Click="DayClick"/>
          <RadioButton x:Name="QuickNight" Grid.Column="1" Content="Night" GroupName="QuickProfile" Style="{StaticResource ProfileTab}" Padding="12,7" MinWidth="0" MinHeight="36" Click="NightClick"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="Auto" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ToggleButton x:Name="QuickAuto" Style="{StaticResource Switch}" Click="AutoClick" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Quick automatic sunrise and sunset schedule"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Control mode" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox x:Name="QuickMode" Style="{StaticResource SettingsChoice}" SelectionChanged="ModeChanged" AutomationProperties.Name="Quick control mode">
          <ComboBoxItem Content="Individual"/>
          <ComboBoxItem Content="Mass"/>
          <ComboBoxItem Content="Offset"/>
        </ComboBox>
        <StackPanel x:Name="MonitorSelector" Margin="0,10,0,0">
          <ListBox x:Name="QuickMonitor" SelectionMode="Single" IsSynchronizedWithCurrentItem="False" SelectedValuePath="Id" SelectionChanged="MonitorChanged"
                   Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Quick controls display">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Width" Value="44"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,0,8,4"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="{Binding Name}"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Surface" CornerRadius="9" Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource TabBorder}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource TabHover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentText}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentText}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayNumber}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="QuickMonitorName" Text="{Binding SelectedItem.Name, ElementName=QuickMonitor}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding SelectedItem.Name, ElementName=QuickMonitor}" Margin="0,3,0,0"/>
        </StackPanel>
        <TextBlock x:Name="QuickHint" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,12"/>
        <UniformGrid Columns="3" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Brightness" FontSize="11" TextAlignment="Center"/>
            <Viewbox Height="32" Margin="4,4,4,8" StretchDirection="DownOnly"><TextBlock x:Name="BrightnessValue" FontSize="24" FontWeight="Light"/></Viewbox>
            <Slider x:Name="BrightnessSlider" Tag="Brightness" ValueChanged="ControlChanged" Style="{StaticResource VerticalControl}"
                    Foreground="{DynamicResource BrightnessFill}" Background="{DynamicResource BrightnessThumb}" AutomationProperties.Name="Quick brightness"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Contrast" FontSize="11" TextAlignment="Center"/>
            <Viewbox Height="32" Margin="4,4,4,8" StretchDirection="DownOnly"><TextBlock x:Name="ContrastValue" FontSize="24" FontWeight="Light"/></Viewbox>
            <Slider x:Name="ContrastSlider" Tag="Contrast" ValueChanged="ControlChanged" Style="{StaticResource VerticalControl}"
                    Foreground="{DynamicResource ContrastFill}" Background="{DynamicResource ContrastThumb}" AutomationProperties.Name="Quick contrast"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Saturation" FontSize="11" TextAlignment="Center"/>
            <Viewbox Height="32" Margin="4,4,4,8" StretchDirection="DownOnly"><TextBlock x:Name="SaturationValue" FontSize="24" FontWeight="Light"/></Viewbox>
            <Slider x:Name="SaturationSlider" Tag="Saturation" ValueChanged="ControlChanged" Style="{StaticResource VerticalControl}"
                    local:SaturationAppearance.Color="{DynamicResource SaturationColor}" BorderBrush="White" AutomationProperties.Name="Quick saturation"/>
          </StackPanel>
        </UniformGrid>
        <TextBlock x:Name="QuickError" Foreground="{DynamicResource ErrorColor}" FontSize="11" TextWrapping="Wrap"/>
        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,10,0,10"/>
        <TextBlock x:Name="QuickSchedule" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="QuickRefresh" Content="Refresh displays" Click="RefreshClick" Style="{StaticResource QuietButton}" Padding="8,6" FontSize="11"/>
          <Button Grid.Column="2" Content="Open full settings" Click="OpenClick" Padding="8,6"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
